# Vercel server-side email alert configuration. Never expose these in public JS.
RESEND_API_KEY=re_replace_me
RESEND_FROM=BoxBoxF1Fantasy Updates <updates@boxboxf1fantasy.com>
RESEND_SIM_UPDATES_SEGMENT_ID=replace_me
SUBSCRIPTION_SIGNING_SECRET=replace_with_a_long_random_secret
SUBSCRIPTION_TOKEN_TTL_HOURS=48
# Optional separate HMAC secret for the HttpOnly Beat V13 entrant session.
# Falls back to SUBSCRIPTION_SIGNING_SECRET when omitted.
BEAT_V13_SESSION_SECRET=replace_with_a_long_random_secret
SITE_ORIGIN=https://boxboxf1fantasy.com

# Added automatically when the Supabase Marketplace database is attached.
NEXT_PUBLIC_SUPABASE_URL=https://replace_me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Ko-fi Pit Wall membership sync.
KOFI_VERIFICATION_TOKEN=replace_with_the_token_from_kofi_webhook_settings
KOFI_PIT_WALL_TIER_NAME=Pit Wall
RESEND_PIT_WALL_SEGMENT_ID=replace_me

# The same random value must exist in Vercel and the GitHub repository secret.
MEMBER_NOTIFICATION_SECRET=replace_with_a_long_random_secret

# Read-only official F1 Fantasy session used for global team lookup and lineup
# sync. Set the full Cookie request header value as an encrypted Vercel secret;
# never expose it to browsers. No organiser ID or league membership is needed.
F1_FANTASY_SESSION_COOKIE=
# This public league powers an optional Beat V13 benchmark only.
F1_FANTASY_LEAGUE_ID=160604
F1_FANTASY_LEAGUE_TYPE=public
CRON_SECRET=replace_with_a_long_random_secret
